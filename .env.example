# Self-Improving Agent Configuration
# Copy to .env and fill in values

# Groq API (separate key from production OH Companion)
GROQ_API_KEY=your_groq_api_key_here
# Groq retired every Llama chat model on 2026-08-16. Leave unset to use the
# default (openai/gpt-oss-120b); retired ids set here are ignored with a warning.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Local MLX model
MLX_MODEL=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit

# Routing
SIA_ROUTING_MODE=auto  # auto, local-only, remote-only

# Logging
SIA_LOG_DIR=logs
SIA_LOG_LEVEL=INFO

# Evaluation
SIA_EVAL_TESTS_DIR=evaluation/golden_tests
